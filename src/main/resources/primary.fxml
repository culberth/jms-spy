<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox fx:id="rootPane" spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.jfx.spring.jms.PrimaryController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>

    <MenuBar>
        <Menu text="File">
            <MenuItem text="Clear" onAction="#clearOutput"/>
            <SeparatorMenuItem/>
            <MenuItem text="Close" onAction="#closeApplication"/>
        </Menu>
        <Menu text="Edit">
            <MenuItem text="Settings" onAction="#showSettingsDialog"/>
        </Menu>
        <Menu text="Help">
            <MenuItem text="About" onAction="#showAboutDialog"/>
        </Menu>
    </MenuBar>

    <HBox alignment="CENTER_RIGHT">
        <CheckBox fx:id="darkModeCheckBox" text="Dark Mode"/>
    </HBox>

    <GridPane hgap="10.0" vgap="8.0">
        <columnConstraints>
            <ColumnConstraints minWidth="90.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0"/>
            <ColumnConstraints minWidth="90.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="150.0"/>
        </columnConstraints>

        <Label text="Broker URL" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="brokerUrlField" promptText="tcp://localhost:61616" GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>
        <Label text="Username" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Password" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
    </GridPane>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button fx:id="connectButton" text="Connect" onAction="#toggleConnection" prefWidth="110.0"/>
        <Label fx:id="connectionStatusLabel" text="Disconnected"/>
    </HBox>

    <TabPane VBox.vgrow="ALWAYS">
        <Tab text="Subscribe" closable="false">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="10.0" left="0.0" right="0.0" top="10.0"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Destinations"/>
                    <ComboBox fx:id="destinationCombo" editable="true" promptText="employee-events, item-events"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <RadioButton fx:id="queueRadio" text="Queue">
                        <toggleGroup>
                            <ToggleGroup fx:id="destinationTypeGroup"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="topicRadio" text="Topic" toggleGroup="$destinationTypeGroup"/>
                    <Button fx:id="listenButton" text="Listen" onAction="#toggleListening" prefWidth="110.0"
                            disable="true"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="On new message:"/>
                    <RadioButton fx:id="appendRadio" text="Append">
                        <toggleGroup>
                            <ToggleGroup fx:id="displayModeGroup"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="replaceRadio" text="Replace" toggleGroup="$displayModeGroup"/>
                </HBox>

                <TextArea fx:id="messageArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
            </VBox>
        </Tab>

        <Tab text="Publish" closable="false">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="10.0" left="0.0" right="0.0" top="10.0"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Destination"/>
                    <ComboBox fx:id="publishDestinationCombo" editable="true" promptText="employee-events"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <RadioButton fx:id="publishQueueRadio" text="Queue">
                        <toggleGroup>
                            <ToggleGroup fx:id="publishDestinationTypeGroup"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="publishTopicRadio" text="Topic"
                                 toggleGroup="$publishDestinationTypeGroup"/>
                </HBox>

                <TextArea fx:id="messageToPublishArea" promptText="Message body to send" wrapText="true"
                          VBox.vgrow="ALWAYS"/>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button fx:id="publishButton" text="Publish" onAction="#publish" prefWidth="110.0"
                            disable="true"/>
                    <Label fx:id="publishStatusLabel"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
